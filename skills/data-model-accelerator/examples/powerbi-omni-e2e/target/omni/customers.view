catalog: DMA_POWERBI
schema: GOLD
table_name: DIM_CUSTOMERS
label: Effective customer history
dimensions:
  customer_key:
    sql: '"CUSTOMER_KEY"'
    primary_key: true
  tenant_id:
    sql: '"TENANT_ID"'
  customer_id:
    sql: '"CUSTOMER_ID"'
  segment:
    sql: '"SEGMENT"'
  valid_from:
    sql: '"VALID_FROM"'
  valid_to:
    sql: '"VALID_TO"'
description: History rows keyed by tenant/customer/valid-from. Segment filters propagate
  to invoices through the exact effective key.
