# Illustrative only. No credentials, native connection, grants, or deployment is supplied.
powerbi_billing_migration:
  target: fixture
  outputs:
    fixture:
      type: snowflake
      account: "{{ env_var('DMA_POWERBI_SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('DMA_POWERBI_SNOWFLAKE_USER') }}"
      authenticator: externalbrowser
      database: DMA_POWERBI
      warehouse: "{{ env_var('DMA_POWERBI_SNOWFLAKE_WAREHOUSE') }}"
      role: "{{ env_var('DMA_POWERBI_SNOWFLAKE_ROLE') }}"
      schema: DMA_POWERBI_FIXTURE
      threads: 1
