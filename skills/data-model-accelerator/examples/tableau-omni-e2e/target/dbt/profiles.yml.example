# Illustrative only. No credentials, native connection, grants, or deployment is supplied.
tableau_billing_migration:
  target: fixture
  outputs:
    fixture:
      type: snowflake
      account: "{{ env_var('DMA_TABLEAU_SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('DMA_TABLEAU_SNOWFLAKE_USER') }}"
      authenticator: externalbrowser
      database: DMA_TABLEAU
      warehouse: "{{ env_var('DMA_TABLEAU_SNOWFLAKE_WAREHOUSE') }}"
      role: "{{ env_var('DMA_TABLEAU_SNOWFLAKE_ROLE') }}"
      schema: DMA_TABLEAU_FIXTURE
      threads: 1
