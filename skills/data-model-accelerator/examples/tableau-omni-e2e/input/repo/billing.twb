    <worksheet name="Revenue Share">
      <table>
        <view>
          <datasources>
            <datasource name="federated.billing" caption="Billing invoices" />
            <datasource name="Parameters" caption="Parameters" />
          </datasources>
          <datasource-dependencies datasource="federated.billing">
            <column name="[Tenant ID]" caption="Tenant ID" datatype="string" role="dimension" type="nominal" />
            <column name="[Invoice ID]" caption="Invoice ID" datatype="string" role="dimension" type="nominal" />
            <column name="[Customer ID]" caption="Customer ID" datatype="string" role="dimension" type="nominal" />
            <column name="[Invoice Date]" caption="Invoice Date" datatype="date" role="dimension" type="nominal" />
            <column name="[Amount Cents]" caption="Amount Cents" datatype="integer" role="measure" type="quantitative" />
            <column name="[Adjustment Cents]" caption="Adjustment Cents" datatype="integer" role="measure" type="quantitative" />
            <column name="[Paid Cents]" caption="Paid Cents" datatype="integer" role="measure" type="quantitative" />
            <column name="[Status]" caption="Status" datatype="string" role="dimension" type="nominal" />
            <column name="[Segment]" caption="Segment" datatype="string" role="dimension" type="nominal" />
            <column name="[Net Cents]" caption="Net Cents" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="[Amount Cents] + ZN([Adjustment Cents])" />
            </column>
            <column name="[Outstanding Cents]" caption="Outstanding Cents" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="[Net Cents] - [Paid Cents]" />
            </column>
            <column name="[Invoice Month]" caption="Invoice Month" datatype="date" role="dimension" type="nominal">
              <calculation class="tableau" formula="DATETRUNC('month', [Invoice Date])" />
            </column>
            <column name="[Posted Population]" caption="Posted Population" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Status] = 'posted'" />
            </column>
            <column name="[Tenant Population]" caption="Tenant Population" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Tenant ID] = [Parameters].[Tenant]" />
            </column>
            <column name="[Date Window]" caption="Date Window" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Invoice Date] &gt;= [Parameters].[Start Date] AND [Invoice Date] &lt; [Parameters].[End Date]" />
            </column>
            <column name="[Segment Selection]" caption="Segment Selection" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[Segment] = 'ALL' OR [Segment] = [Parameters].[Segment]" />
            </column>
            <column name="[Fixed Customer Net]" caption="Fixed Customer Net" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="{ FIXED [Tenant ID], [Customer ID] : SUM([Net Cents]) }" />
            </column>
            <column name="[Revenue]" caption="Revenue" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([Net Cents])" />
            </column>
            <column name="[Paid]" caption="Paid" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([Paid Cents])" />
            </column>
            <column name="[Outstanding]" caption="Outstanding" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([Outstanding Cents])" />
            </column>
            <column name="[Payment Rate]" caption="Payment Rate" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF SUM([Net Cents]) = 0 THEN NULL ELSE SUM([Paid Cents]) / SUM([Net Cents]) END" />
            </column>
            <column name="[Scenario Revenue]" caption="Scenario Revenue" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([Net Cents]) * [Parameters].[Multiplier]" />
            </column>
            <column name="[Displayed Fixed Customer Net]" caption="Displayed Fixed Customer Net" datatype="integer" role="measure" type="quantitative">
              <calculation class="tableau" formula="MIN([Fixed Customer Net])" />
            </column>
            <column name="[Revenue Share]" caption="Revenue Share" datatype="real" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF WINDOW_SUM(SUM([Net Cents])) = 0 THEN NULL ELSE SUM([Net Cents]) / WINDOW_SUM(SUM([Net Cents])) END">
                <table-calc ordering-type="Field" ordering-field="[federated.billing].[Segment]" />
              </calculation>
            </column>
            <column-instance column="[Invoice Month]" name="[none:Invoice Month:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[Segment]" name="[none:Segment:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[Date Window]" name="[none:Date Window:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[Segment Selection]" name="[none:Segment Selection:nk]" derivation="None" pivot="key" type="nominal" />
            <column-instance column="[Revenue]" name="[usr:Revenue:qk]" derivation="User" pivot="key" type="quantitative" />
            <column-instance column="[Revenue Share]" name="[usr:Revenue Share:qk]" derivation="User" pivot="key" type="quantitative">
              <table-calc ordering-type="Field">
                <order field="[federated.billing].[Segment]" />
              </table-calc>
            </column-instance>
          </datasource-dependencies>
          <filter class="categorical" column="[federated.billing].[none:Date Window:nk]" context="true">
            <groupfilter function="member" level="[none:Date Window:nk]" member="true" />
          </filter>
          <filter class="categorical" column="[federated.billing].[none:Segment Selection:nk]" context="false">
            <groupfilter function="member" level="[none:Segment Selection:nk]" member="true" />
          </filter>
          <aggregation value="true" />
        </view>
        <panes>
          <pane>
            <mark class="Text" />
            <encodings>
              <text column="[federated.billing].[usr:Revenue:qk]" />
              <text column="[federated.billing].[usr:Revenue Share:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.billing].[none:Invoice Month:nk] / [federated.billing].[none:Segment:nk]</rows>
        <cols />
      </table>
      <simple-id uuid="{2547e914-84d9-5bf6-b015-bb4459a4f694}" />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Billing Overview">
      <size maxheight="1200" maxwidth="1200" minheight="1200" minwidth="1200" sizing-mode="fixed" />
      <zones>
        <zone name="Revenue Trend" id="1" type-v2="viz" x="0" y="0" w="100000" h="33333" />
        <zone name="Customer Value" id="2" type-v2="viz" x="0" y="33333" w="100000" h="33333" />
        <zone name="Revenue Share" id="3" type-v2="viz" x="0" y="66666" w="100000" h="33333" />
      </zones>
    </dashboard>
  </dashboards>
</workbook>
