# Synthetic candidate. Native Omni validation remains outstanding.
catalog: DMA_HEX
schema: GOLD
table_name: FCT_INVOICES
label: Invoice billing
description: All current invoice statuses at tenant/invoice grain. Posted report population
  lives in measures and report context.
dimensions:
  tenant_id:
    sql: '"TENANT_ID"'
    hidden: true
  invoice_id:
    sql: '"INVOICE_ID"'
  customer_id:
    sql: '"CUSTOMER_ID"'
  invoice_date:
    sql: '"INVOICE_DATE"'
  invoice_month:
    sql: '"INVOICE_MONTH"'
  status:
    sql: '"STATUS"'
  amount_cents:
    sql: '"AMOUNT_CENTS"'
    hidden: true
  adjustment_cents:
    sql: '"ADJUSTMENT_CENTS"'
    hidden: true
  net_cents:
    sql: '"NET_CENTS"'
    hidden: true
  paid_cents:
    sql: '"PAID_CENTS"'
    hidden: true
  outstanding_cents:
    sql: '"OUTSTANDING_CENTS"'
    hidden: true
  invoice_key:
    sql: '"INVOICE_KEY"'
    primary_key: true
    hidden: true
  customer_key:
    sql: '"CUSTOMER_KEY"'
    hidden: true
  segment:
    sql: '"SEGMENT"'
    description: Invoice-date historical segment; do not replace with current segment
      or customer-month segment.
  first_paid_month:
    sql: ${customer_month.first_paid_month}
    description: Earliest positive-paid posted invoice month at snapshot; invoice-based
      proxy, not payment-event-time cohort.
  invoiced_active_customer_key:
    sql: CASE WHEN "STATUS" = 'posted' AND "NET_CENTS" > 0 THEN "TENANT_ID" || '|'
      || "CUSTOMER_ID" END
    hidden: true
    description: Distinct tenant/customer identity for the retention project definition.
      Null outside posted positive-net population.
  paying_active_customer_key:
    sql: CASE WHEN "STATUS" = 'posted' AND "PAID_CENTS" > 0 THEN "TENANT_ID" || '|'
      || "CUSTOMER_ID" END
    hidden: true
    description: Distinct tenant/customer identity for the executive project definition.
      Null outside posted positive-paid population.
measures:
  invoice_count:
    sql: ${invoices.invoice_key}
    aggregate_type: count
    filters:
      status:
        is: posted
  raw_net_cents_sum:
    sql: ${invoices.net_cents}
    aggregate_type: sum
    filters:
      status:
        is: posted
    hidden: true
  revenue_cents:
    sql: COALESCE(${raw_net_cents_sum}, 0)
    label: Revenue (USD cents)
    description: Posted invoice total after query filters; explicit empty-set zero.
      Negative values preserved.
    format: '#,##0'
  raw_paid_cents_sum:
    sql: ${invoices.paid_cents}
    aggregate_type: sum
    filters:
      status:
        is: posted
    hidden: true
  paid_cents_total:
    sql: COALESCE(${raw_paid_cents_sum}, 0)
    label: Paid (USD cents)
    description: Posted invoice total after query filters; explicit empty-set zero.
      Negative values preserved.
    format: '#,##0'
  raw_outstanding_cents_sum:
    sql: ${invoices.outstanding_cents}
    aggregate_type: sum
    filters:
      status:
        is: posted
    hidden: true
  outstanding_cents_total:
    sql: COALESCE(${raw_outstanding_cents_sum}, 0)
    label: Outstanding (USD cents)
    description: Posted invoice total after query filters; explicit empty-set zero.
      Negative values preserved.
    format: '#,##0'
  payment_rate:
    sql: ${paid_cents_total} / NULLIF(${revenue_cents}, 0)
    label: Payment rate
    description: Ratio of selected paid and net sums. Null at zero net; not an average
      or sum of invoice ratios.
    format: 0.00%
  invoiced_active_customers:
    sql: ${invoices.invoiced_active_customer_key}
    aggregate_type: count_distinct
    label: Invoiced active customers
    description: Separate proposed metric retaining its original project definition;
      human decision required before naming any canonical active_customers metric.
  paying_active_customers:
    sql: ${invoices.paying_active_customer_key}
    aggregate_type: count_distinct
    label: Paying active customers
    description: Separate proposed metric retaining its original project definition;
      human decision required before naming any canonical active_customers metric.
  revenue_usd:
    sql: ${revenue_cents} / 100.0
    label: Revenue (USD)
    format: $#,##0.00
    description: Display conversion from USD cents exactly once; no currency conversion.
