flowchart LR
  work_orders["raw: work_orders<br/>One row per work_order_id"]
  parts["raw: parts<br/>One row per part_line_id"]
  bronze_work_orders["bronze: bronze_work_orders<br/>One row per work_order_id in the supplied snapshot; no historical uniqueness asserted"]
  bronze_parts["bronze: bronze_parts<br/>One row per part_line_id in the supplied snapshot; no historical uniqueness asserted"]
  silver_work_orders["silver: silver_work_orders<br/>One row per work_order_id"]
  silver_parts["silver: silver_parts<br/>One row per part_line_id"]
  gold_work_orders["gold: gold_work_orders<br/>One row per work_order_id"]
  work_orders -->|"lineage"| bronze_work_orders
  parts -->|"lineage"| bronze_parts
  bronze_work_orders -->|"lineage"| silver_work_orders
  bronze_parts -->|"lineage"| silver_parts
  silver_work_orders -->|"lineage"| gold_work_orders
  silver_parts -->|"preaggregate then left join"| gold_work_orders
%% Arrows are transformation lineage, never enforced warehouse foreign keys.
