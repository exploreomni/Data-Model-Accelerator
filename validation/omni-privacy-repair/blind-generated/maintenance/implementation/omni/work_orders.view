catalog: SYNTHETIC_REVIEW
dimensions:
  labor_cost:
    sql: '"LABOR_COST"'
  opened_on:
    sql: '"OPENED_ON"'
  parts_cost:
    sql: '"PARTS_COST"'
  status:
    sql: '"STATUS"'
  tenant_id:
    sql: '"TENANT_ID"'
  work_cost:
    sql: '"WORK_COST"'
  work_order_id:
    primary_key: true
    sql: '"WORK_ORDER_ID"'
measures:
  total_work_cost:
    aggregate_type: sum
    sql: ${work_orders.work_cost}
schema: DMA_MAINTENANCE
table_name: GOLD_WORK_ORDERS
