catalog: synthetic-review
dimensions:
  kwh:
    sql: '`kwh`'
  meter_id:
    sql: '`meter_id`'
  reading_id:
    primary_key: true
    sql: '`reading_id`'
  recorded_on:
    sql: '`recorded_on`'
  zone:
    sql: '`zone`'
measures:
  total_kwh:
    aggregate_type: sum
    sql: ${readings.kwh}
schema: dma_energy
table_name: gold_readings
