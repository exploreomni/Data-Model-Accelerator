flowchart LR
  readings["raw: readings<br/>One row per reading_id"]
  meters["raw: meters<br/>One row per meter_id"]
  bronze_readings["bronze: bronze_readings<br/>One row per reading_id in the supplied snapshot; no historical uniqueness asserted"]
  bronze_meters["bronze: bronze_meters<br/>One row per meter_id in the supplied snapshot; no historical uniqueness asserted"]
  silver_readings["silver: silver_readings<br/>One row per reading_id"]
  silver_meters["silver: silver_meters<br/>One row per meter_id"]
  gold_readings["gold: gold_readings<br/>One row per reading_id"]
  readings -->|"lineage"| bronze_readings
  meters -->|"lineage"| bronze_meters
  bronze_readings -->|"lineage"| silver_readings
  bronze_meters -->|"lineage"| silver_meters
  silver_readings -->|"lineage"| gold_readings
  silver_meters -->|"unique lookup"| gold_readings
