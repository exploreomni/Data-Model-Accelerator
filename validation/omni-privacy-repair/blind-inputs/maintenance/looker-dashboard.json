{
  "id": "maintenance-source",
  "title": "Synthetic maintenance",
  "dashboard_elements": [
    {
      "id": "maintenance-total",
      "type": "vis",
      "query": {
        "id": "maintenance-q1",
        "model": "maintenance",
        "view": "work_orders",
        "fields": [
          "work_orders.total_work_cost"
        ],
        "filters": {
          "work_orders.status": "closed",
          "work_orders.opened_on": "2026-01-02 to 2026-01-03"
        },
        "limit": "500"
      },
      "listen": {
        "Date": "work_orders.opened_on"
      }
    },
    {
      "id": "maintenance-detail",
      "type": "vis",
      "query": {
        "id": "maintenance-q2",
        "model": "maintenance",
        "view": "work_orders",
        "fields": [
          "work_orders.opened_on",
          "work_orders.total_work_cost"
        ],
        "filters": {
          "work_orders.status": "closed",
          "work_orders.opened_on": "2026-01-02 to 2026-01-03"
        },
        "sorts": [
          "work_orders.opened_on asc"
        ],
        "limit": "500"
      },
      "listen": {
        "Date": "work_orders.opened_on"
      }
    },
    {
      "id": "maintenance-note",
      "type": "text",
      "body_text": "Synthetic exercise. Native data freshness and business acceptance are pending."
    }
  ],
  "dashboard_filters": [
    {
      "id": "maintenance-date",
      "name": "Date",
      "type": "date_filter",
      "default_value": "2026-01-02 to 2026-01-03"
    }
  ],
  "dashboard_layouts": [
    {
      "id": "maintenance-layout",
      "active": true,
      "dashboard_layout_components": [
        {
          "id": "maintenance-layout-0",
          "dashboard_element_id": "maintenance-total",
          "row": 0,
          "column": 0,
          "width": 12,
          "height": 4
        },
        {
          "id": "maintenance-layout-1",
          "dashboard_element_id": "maintenance-detail",
          "row": 4,
          "column": 0,
          "width": 12,
          "height": 4
        },
        {
          "id": "maintenance-layout-2",
          "dashboard_element_id": "maintenance-note",
          "row": 8,
          "column": 0,
          "width": 12,
          "height": 4
        }
      ]
    }
  ]
}
